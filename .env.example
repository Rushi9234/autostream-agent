# Copy this file to .env and paste your Gemini API key below.
# Get a free key from https://aistudio.google.com/app/apikey

GOOGLE_API_KEY=your_gemini_api_key_here

# Required to call POST /approve (api.py) -- without it, anyone who knew or
# guessed a thread_id could approve/reject someone else's lead. If you don't
# set this, api.py generates a random one at startup and prints it once.
ADMIN_TOKEN=

# Whether /chat auto-approves a completed lead itself instead of leaving it
# for a human to call /approve. Defaults to true (this is a public demo with
# no real reviewer behind it) -- set to false for a deployment where /approve
# should be the only way a lead ever actually gets captured.
AUTO_APPROVE_DEMO_LEADS=true
